test bytes_iec = format_bytes_iec(1023) == "1023 B" and format_bytes_iec(1024) == "1 KiB" and format_bytes_iec(1536) == "1.5 KiB" and format_bytes_iec(1048576) == "1 MiB" and format_bytes_iec(1073741824 * 3) == "3 GiB" and format_bytes_iec(1048575) == "1 MiB"

test bytes_decimals = format_bytes_with(1234567, false, 3) == "1.235 MB" and format_bytes_with(1234567, false, 0) == "1 MB" and format_bytes_with(1500, true, 2) == "1.46 KiB" and format_bytes_with(-5, true, 2) == "-5 B"

test bytes_parse = parse_bytes("1.5 GB") == some(1500000000) and parse_bytes("10MiB") == some(10485760) and parse_bytes("512") == some(512) and parse_bytes("2 kb") == some(2000) and parse_bytes("3 bytes") == some(3) and parse_bytes("1 KiB") == some(1024) and parse_bytes(" 7k ") == some(7000) and parse_bytes("1 EiB") == some(1152921504606846976) and parse_bytes("0.5 B") == some(0) and parse_bytes("1.5 B") == some(2)

test bytes_parse_rejects = ["", "GB", "1.5 XB", "1..5 GB", "1 kib bytes", "8 EiB", "100 EB", "1,000 B", "1 kbs", "- 1 B"].all(s => parse_bytes(s) == none)

test bytes_round_trip = [0, 1, 999, 1000, 1500, 2300000, 123000000].all(n => parse_bytes(format_bytes(n)) == some(n))

test durations_short = format_duration(millis(0)) == "0ms" and format_duration(millis(250)) == "250ms" and format_duration(millis(1250)) == "1s 250ms" and format_duration(hours(1).add(mins(2)).add(secs(3))) == "1h 2m 3s" and format_duration(days(1).add(hours(2)).add(mins(3)).add(secs(4))) == "1d 2h 3m 4s" and format_duration(millis(-5400000)) == "-1h 30m" and format_ms(86400000) == "1d" and format_ms(-1) == "-1ms"

test durations_extreme = format_ms(9223372036854775807) == "106751991167d 7h 12m 55s 807ms" and format_ms(-9223372036854775807 - 1) == "-106751991167d 7h 12m 55s 808ms"

test durations_long = format_duration_long(millis(0)) == "0 seconds" and format_duration_long(hours(1).add(mins(2)).add(secs(3))) == "1 hour, 2 minutes and 3 seconds" and format_duration_long(millis(250)) == "250 milliseconds" and format_duration_long(days(2).neg) == "minus 2 days" and format_duration_long(mins(1).add(millis(1))) == "1 minute and 1 millisecond"

